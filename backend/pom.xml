<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.ipt</groupId>
    <artifactId>ged</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ged</name>
    <description>GED - Gestion Electronique de Documents (Spring Boot)</description>

    <properties>
        <!-- Java 17 LTS — socle exigé par le client (compatible Spring Boot 3.x) -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Seuil CVSS au-dela duquel OWASP Dependency-Check fait echouer la
             construction (DAT 6.2.3, A06). Surchargeable : -Dged.cvss.seuil=9 -->
        <ged.cvss.seuil>7</ged.cvss.seuil>
    </properties>

    <dependencies>
        <!-- Lecture des fichiers bureautiques : les types de document
             autorisent docx/xlsx, mais aucun extracteur ne savait les lire. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>5.3.0</version>
        </dependency>
        <!-- Web / REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lecture de la couche texte des PDF natifs (chaîne d'OCRisation, étage 1) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <!-- Persistence (JPA / Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation (Bean Validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Export des metriques au format Prometheus (DAT 6.7). Le point
             /actuator/prometheus n'est servi que sur le port de management,
             lie au reseau interne (voir exploitation.yml). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Security (auth + ACL) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Jetons JWT signes (HMAC-SHA256) : jjwt 0.12, API/implementation/serialiseur
             separes comme le prevoit la bibliotheque. -->
        <dependency>
        	<groupId>io.jsonwebtoken</groupId>
        	<artifactId>jjwt-api</artifactId>
        	<version>0.12.6</version>
        </dependency>
        <dependency>
        	<groupId>io.jsonwebtoken</groupId>
        	<artifactId>jjwt-impl</artifactId>
        	<version>0.12.6</version>
        	<scope>runtime</scope>
        </dependency>
        <dependency>
        	<groupId>io.jsonwebtoken</groupId>
        	<artifactId>jjwt-jackson</artifactId>
        	<version>0.12.6</version>
        	<scope>runtime</scope>
        </dependency>

        <!-- Lombok (reduce boilerplate) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SGBD imposé par le CPS (dossier technique §2.2, §4.1) : PostgreSQL 16+,
             dans TOUS les profils. H2 et MySQL sont retirés : un schéma testé sur
             un autre moteur que celui de production ne prouve rien (types JSONB,
             UUID, index GIN et recherche plein texte n'y existent pas). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Sonde de vie.
             `SecurityConfig` ouvrait deja `/actuator/health` et `/api/v1/health`,
             mais les deux repondaient 404 : l'actuator n'etait pas au projet et
             aucun controleur ne servait la seconde. Une supervision, un
             repartiteur de charge ou un orchestrateur n'avaient donc AUCUN moyen
             de savoir si l'application etait vivante. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Migrations de schéma : Liquibase 4, outil nommé par le CPS (Article 50,
             dossier technique §4.2). C'est la SEULE source du schéma : Hibernate
             ne fait que vérifier (`ddl-auto: validate`) dans tous les profils. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- API documentation (Swagger UI) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>

        <!-- ===== DEBUT lot E5 (dev3) — stockage sécurisé des fichiers ===== -->
        <!-- Détection du type réel par signature (§6.1.5). Seul le noyau est
             retenu : il reconnaît PDF, images, texte, ODF et conteneurs OOXML
             sans tirer les analyseurs complets (POI en double, BouncyCastle…) ;
             la distinction docx/xlsx/pptx est faite par FormatsOoxml.
             Le chiffrement (AES-256-GCM), le keystore PKCS#12 et le client
             clamd n'utilisent que le JDK : aucune autre dépendance. -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>3.2.3</version>
        </dependency>
        <!-- ===== FIN lot E5 (dev3) ===== -->

        <!-- ===== DEBUT lot E8 notifications (dev2) ===== -->
        <!-- Canal e-mail des notifications (DAT §12.9) : relais SMTP de MMED,
             configuration externalisée (notification.yml). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- ===== FIN lot E8 notifications (dev2) ===== -->

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Serveur SMTP simulé pour les tests des notifications (lot E8, dev2) :
             aucun relais réel n'est joint depuis la suite de tests. -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lombok déclaré explicitement comme processeur d'annotations
                 (bonne pratique : indépendant du comportement implicite du JDK). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- A06 (DAT 6.2.3) : analyse des dependances a chaque construction.
                 Lie a la phase verify : `mvn verify` (CI) echoue des qu'une
                 dependance porte une vulnerabilite de score >= ged.cvss.seuil.
                 En local, `-Ddependency-check.skip=true` evite le telechargement
                 de la base NVD. La cle d'API NVD est lue dans NVD_API_KEY :
                 sans elle la mise a jour de la base prend plusieurs heures. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.2.2</version>
                <configuration>
                    <failBuildOnCVSS>${ged.cvss.seuil}</failBuildOnCVSS>
                    <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <!-- Sonatype OSS Index exige desormais un compte : sans
                         identifiants l'analyseur echoue au lieu d'analyser. -->
                    <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
                    <!-- Le front est analyse par npm audit dans la CI : ces
                         analyseurs ne verraient ici aucun package.json. -->
                    <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                    <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                    <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                    <suppressionFiles>
                        <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                </configuration>
                <executions>
                    <execution>
                        <id>analyse-vulnerabilites</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- SBOM CycloneDX (DAT 8.3) : nom, version, licence et empreinte de
                 chaque dependance, directe ou transitive, produit a chaque
                 `mvn package` dans target/bom.json et target/bom.xml. -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.1</version>
                <configuration>
                    <projectType>application</projectType>
                    <schemaVersion>1.6</schemaVersion>
                    <outputFormat>all</outputFormat>
                    <outputName>bom</outputName>
                    <includeLicenseText>false</includeLicenseText>
                    <!-- Le registre couvre ce qui part en production. -->
                    <includeTestScope>false</includeTestScope>
                </configuration>
                <executions>
                    <execution>
                        <id>sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
