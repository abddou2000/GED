<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changesets/202609261005_creation_table_compte_utilisateur.xml">

    <changeSet id="202609261005-1" author="ged">
        <comment>Compte de connexion local (transitoire : supprimé par le lot E2 au profit de l'annuaire LDAP).</comment>
        <createTable tableName="compte_utilisateur">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_compte_utilisateur" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(190)">
                <constraints nullable="false"/>
            </column>
            <column name="mot_de_passe" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="actif" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="employe_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="derniere_connexion" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addUniqueConstraint constraintName="uk_compte_utilisateur_email" tableName="compte_utilisateur" columnNames="email"/>
        <addUniqueConstraint constraintName="uk_compte_utilisateur_employe_id" tableName="compte_utilisateur" columnNames="employe_id"/>
        <addForeignKeyConstraint constraintName="fk_compte_utilisateur_employe" baseTableName="compte_utilisateur" baseColumnNames="employe_id"
                                 referencedTableName="employe" referencedColumnNames="id"/>
        <rollback>
            <dropTable tableName="compte_utilisateur"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
