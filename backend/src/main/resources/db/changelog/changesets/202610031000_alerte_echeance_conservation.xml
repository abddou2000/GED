<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changesets/202610031000_alerte_echeance_conservation.xml">

    <!--
        Alerte d'échéance de conservation (DAT §12.9, T-112) : une tâche
        quotidienne signale les documents dont l'échéance est atteinte et non
        encore signalés, sous verrou de tâche (une seule exécution à la fois,
        même à plusieurs instances). Aucune suppression automatique (P4).
    -->

    <changeSet id="202610031000-1" author="ged">
        <comment>Date de signalement de l'échéance atteinte d'un document.</comment>
        <addColumn tableName="document">
            <column name="echeance_signalee_le" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <!-- Sélection quotidienne : documents vivants échus et non signalés. -->
        <sql>CREATE INDEX idx_document_echeance_a_signaler ON ${database.defaultSchemaName}.document (echeance_conservation)
            WHERE echeance_signalee_le IS NULL AND echeance_conservation IS NOT NULL AND NOT supprime</sql>
        <!--
            Échéance recalculée (type, date, métadonnée, point de départ) et
            repoussée dans le futur : le signalement précédent ne vaut plus, le
            document sera signalé à sa nouvelle échéance. Déclencheur nommé après
            trg_document_echeance : PostgreSQL les exécute par ordre alphabétique,
            l'échéance est donc déjà recalculée ici.
        -->
        <sql splitStatements="false"><![CDATA[CREATE OR REPLACE FUNCTION ${database.defaultSchemaName}.document_echeance_resignaler() RETURNS trigger LANGUAGE plpgsql AS $corps$
BEGIN
    IF NEW.echeance_conservation IS DISTINCT FROM OLD.echeance_conservation
       AND (NEW.echeance_conservation IS NULL OR NEW.echeance_conservation > current_date) THEN
        NEW.echeance_signalee_le := NULL;
    END IF;
    RETURN NEW;
END
$corps$]]></sql>
        <sql>CREATE TRIGGER trg_document_echeance_resignaler BEFORE UPDATE ON ${database.defaultSchemaName}.document FOR EACH ROW EXECUTE FUNCTION ${database.defaultSchemaName}.document_echeance_resignaler()</sql>
        <rollback>
            <sql>DROP TRIGGER trg_document_echeance_resignaler ON ${database.defaultSchemaName}.document</sql>
            <sql>DROP FUNCTION ${database.defaultSchemaName}.document_echeance_resignaler()</sql>
            <sql>DROP INDEX ${database.defaultSchemaName}.idx_document_echeance_a_signaler</sql>
            <dropColumn tableName="document" columnName="echeance_signalee_le"/>
        </rollback>
    </changeSet>

    <changeSet id="202610031000-2" author="ged">
        <comment>Verrou des tâches planifiées (bail) : une seule instance exécute une tâche à la fois.</comment>
        <createTable tableName="verrou_tache">
            <column name="id" type="UUID" defaultValueComputed="${database.defaultSchemaName}.uuid_v7()">
                <constraints primaryKey="true" primaryKeyName="pk_verrou_tache" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_verrou_tache_nom"/>
            </column>
            <column name="detenteur" type="VARCHAR(255)"/>
            <column name="verrouille_jusqu_a" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="pris_le" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="derniere_fin" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <rollback>
            <dropTable tableName="verrou_tache"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
