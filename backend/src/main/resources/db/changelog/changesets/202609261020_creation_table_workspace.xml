<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changesets/202609261020_creation_table_workspace.xml">

    <changeSet id="202609261020-1" author="ged">
        <comment>Espaces de travail (dossiers), arborescence auto-référencée.</comment>
        <createTable tableName="workspace">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_workspace" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="employe_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="parent_id" type="UUID"/>
            <column name="workflow_ged_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addUniqueConstraint constraintName="uk_workspace_code" tableName="workspace" columnNames="code"/>
        <addForeignKeyConstraint constraintName="fk_workspace_employe" baseTableName="workspace" baseColumnNames="employe_id"
                                 referencedTableName="employe" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_workspace_parent" baseTableName="workspace" baseColumnNames="parent_id"
                                 referencedTableName="workspace" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_workspace_workflow_ged" baseTableName="workspace" baseColumnNames="workflow_ged_id"
                                 referencedTableName="workflow_ged" referencedColumnNames="id"/>
        <createIndex indexName="idx_workspace_deleted" tableName="workspace">
            <column name="deleted"/>
        </createIndex>
        <createIndex indexName="idx_workspace_parent_id" tableName="workspace">
            <column name="parent_id"/>
        </createIndex>
        <createIndex indexName="idx_workspace_employe_id" tableName="workspace">
            <column name="employe_id"/>
        </createIndex>
        <createIndex indexName="idx_workspace_workflow_ged_id" tableName="workspace">
            <column name="workflow_ged_id"/>
        </createIndex>
        <sql>ALTER TABLE ${database.defaultSchemaName}.workspace ADD CONSTRAINT ck_workspace_status CHECK (status IN ('ACTIF', 'ARCHIVE', 'INACTIF'))</sql>
        <sql>ALTER TABLE ${database.defaultSchemaName}.workspace ADD CONSTRAINT ck_workspace_parent CHECK (parent_id IS NULL OR parent_id &lt;&gt; id)</sql>
        <rollback>
            <dropTable tableName="workspace"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
