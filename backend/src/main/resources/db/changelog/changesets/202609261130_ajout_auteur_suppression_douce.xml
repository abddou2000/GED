<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changesets/202609261130_ajout_auteur_suppression_douce.xml">

    <!--
        Suppression douce avec auteur et date (dossier technique §12.1, §12.5).
        L'indicateur `deleted` existait seul : on savait qu'un objet était en
        corbeille, jamais qui l'y avait mis ni quand. `supprime_par` porte
        l'employé auteur, `supprime_le` l'instant ; tous deux sont renseignés à la
        suppression et vidés à la restauration.

        La contrainte ck_<table>_suppression interdit un auteur ou une date sur un
        objet vivant. Elle ne l'exige pas sur un objet supprimé : les lignes mises
        en corbeille avant cette évolution (reprise) n'ont ni l'un ni l'autre.
    -->
    <changeSet id="202609261130-1" author="ged">
        <comment>Auteur et date de la suppression douce sur toutes les tables à corbeille.</comment>
        <addColumn tableName="workflow_ged">
            <column name="supprime_par" type="UUID"/>
            <column name="supprime_le" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_workflow_ged_supprime_par" baseTableName="workflow_ged" baseColumnNames="supprime_par"
                                 referencedTableName="employe" referencedColumnNames="id"/>
        <sql>ALTER TABLE ${database.defaultSchemaName}.workflow_ged ADD CONSTRAINT ck_workflow_ged_suppression CHECK (deleted OR (supprime_par IS NULL AND supprime_le IS NULL))</sql>
        <addColumn tableName="workspace">
            <column name="supprime_par" type="UUID"/>
            <column name="supprime_le" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_workspace_supprime_par" baseTableName="workspace" baseColumnNames="supprime_par"
                                 referencedTableName="employe" referencedColumnNames="id"/>
        <sql>ALTER TABLE ${database.defaultSchemaName}.workspace ADD CONSTRAINT ck_workspace_suppression CHECK (deleted OR (supprime_par IS NULL AND supprime_le IS NULL))</sql>
        <addColumn tableName="access_group">
            <column name="supprime_par" type="UUID"/>
            <column name="supprime_le" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_access_group_supprime_par" baseTableName="access_group" baseColumnNames="supprime_par"
                                 referencedTableName="employe" referencedColumnNames="id"/>
        <sql>ALTER TABLE ${database.defaultSchemaName}.access_group ADD CONSTRAINT ck_access_group_suppression CHECK (deleted OR (supprime_par IS NULL AND supprime_le IS NULL))</sql>
        <addColumn tableName="etiquette">
            <column name="supprime_par" type="UUID"/>
            <column name="supprime_le" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_etiquette_supprime_par" baseTableName="etiquette" baseColumnNames="supprime_par"
                                 referencedTableName="employe" referencedColumnNames="id"/>
        <sql>ALTER TABLE ${database.defaultSchemaName}.etiquette ADD CONSTRAINT ck_etiquette_suppression CHECK (deleted OR (supprime_par IS NULL AND supprime_le IS NULL))</sql>
        <addColumn tableName="index_def">
