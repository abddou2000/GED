        <sql>ALTER TABLE ${database.defaultSchemaName}.index_def ADD CONSTRAINT ck_index_def_suppression CHECK (deleted OR (supprime_par IS NULL AND supprime_le IS NULL))</sql>
        <addColumn tableName="plan_indexation">
            <column name="supprime_par" type="UUID"/>
            <column name="supprime_le" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_plan_indexation_supprime_par" baseTableName="plan_indexation" baseColumnNames="supprime_par"
                                 referencedTableName="employe" referencedColumnNames="id"/>
        <sql>ALTER TABLE ${database.defaultSchemaName}.plan_indexation ADD CONSTRAINT ck_plan_indexation_suppression CHECK (deleted OR (supprime_par IS NULL AND supprime_le IS NULL))</sql>
        <addColumn tableName="type_document">
            <column name="supprime_par" type="UUID"/>
            <column name="supprime_le" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_type_document_supprime_par" baseTableName="type_document" baseColumnNames="supprime_par"
                                 referencedTableName="employe" referencedColumnNames="id"/>
        <sql>ALTER TABLE ${database.defaultSchemaName}.type_document ADD CONSTRAINT ck_type_document_suppression CHECK (deleted OR (supprime_par IS NULL AND supprime_le IS NULL))</sql>
        <addColumn tableName="document">
            <column name="supprime_par" type="UUID"/>
            <column name="supprime_le" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_document_supprime_par" baseTableName="document" baseColumnNames="supprime_par"
                                 referencedTableName="employe" referencedColumnNames="id"/>
        <sql>ALTER TABLE ${database.defaultSchemaName}.document ADD CONSTRAINT ck_document_suppression CHECK (deleted OR (supprime_par IS NULL AND supprime_le IS NULL))</sql>
        <rollback>
            <sql>ALTER TABLE ${database.defaultSchemaName}.document DROP CONSTRAINT ck_document_suppression</sql>
            <dropForeignKeyConstraint baseTableName="document" constraintName="fk_document_supprime_par"/>
            <dropColumn tableName="document">
