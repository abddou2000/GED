<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changesets/202609281010_creation_table_permission.xml">

    <!--
        Permissions (§12.2.1) : neuf permissions élémentaires, des permissions
        d'administration distinctes, et deux permissions techniques de
        confidentialité (VOIR_PRIVE, VOIR_CONFIDENTIEL). Liste close, livrée par la
        GED : le code s'y réfère. Validées par le client (revue technique D14).
    -->
    <changeSet id="202609281010-1" author="ged">
        <comment>Table des permissions.</comment>
        <createTable tableName="permission">
            <column name="id" type="UUID"><constraints primaryKey="true" primaryKeyName="pk_permission" nullable="false"/></column>
            <column name="code" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="libelle" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="categorie" type="VARCHAR(20)"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint constraintName="uk_permission_code" tableName="permission" columnNames="code"/>
        <sql>ALTER TABLE ${database.defaultSchemaName}.permission ADD CONSTRAINT ck_permission_categorie CHECK (categorie IN ('ELEMENTAIRE', 'ADMINISTRATION', 'CONFIDENTIALITE'))</sql>
        <rollback>
            <dropTable tableName="permission"/>
        </rollback>
    </changeSet>

