<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changesets/202609261050_creation_table_plan_indexation.xml">

    <changeSet id="202609261050-1" author="ged">
        <comment>Plans d'indexation et charte de nommage.</comment>
        <createTable tableName="plan_indexation">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_plan_indexation" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="nom_du_plan" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="mode_indexation" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="manuel" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="majuscule" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="separateur" type="VARCHAR(255)" defaultValue="_">
                <constraints nullable="false"/>
            </column>
            <column name="charte_nommage" type="VARCHAR(2000)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addUniqueConstraint constraintName="uk_plan_indexation_code" tableName="plan_indexation" columnNames="code"/>
        <createIndex indexName="idx_plan_indexation_deleted" tableName="plan_indexation">
            <column name="deleted"/>
        </createIndex>
        <rollback>
            <dropTable tableName="plan_indexation"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
