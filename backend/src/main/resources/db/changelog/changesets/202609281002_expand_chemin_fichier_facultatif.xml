<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changesets/202609281002_expand_chemin_fichier_facultatif.xml">

    <!--
        Lot E5, vague 2 (« expand ») : une nouvelle version n'a plus de chemin en
        clair, seulement son fichier chiffré (cle_fichier_id). La colonne
        file_path ne reste que pour la reprise des fichiers existants, puis
        disparaît (202609281005, « contract »).
    -->
    <changeSet id="202609281002-1" author="ged">
        <comment>Chemin de fichier en clair devenu facultatif sur version_document.</comment>
        <dropNotNullConstraint tableName="version_document" columnName="file_path" columnDataType="VARCHAR(255)"/>
        <rollback>
            <addNotNullConstraint tableName="version_document" columnName="file_path"
                                  columnDataType="VARCHAR(255)" defaultNullValue=""/>
        </rollback>
    </changeSet>

</databaseChangeLog>
