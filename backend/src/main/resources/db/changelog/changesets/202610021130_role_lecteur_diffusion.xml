<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changesets/202610021130_role_lecteur_diffusion.xml">

    <!--
        Diffusion d'un document validé (§12.8) : « ajout d'habilitations de
        lecture sur le document, sans copie ». Aucun des quatre rôles système
        (D14) n'est un rôle de lecture seule : un rôle ORDINAIRE « Lecteur
        (diffusion) », composé de la seule permission Consulter, est livré ;
        il reste modifiable depuis l'écran des rôles.
    -->
    <changeSet id="202610021130-1" author="ged" labels="data-initial">
        <comment>Rôle de lecture utilisé par la diffusion.</comment>
        <insert tableName="role">
            <column name="id" value="0192a000-0000-7000-8000-000000000005"/>
            <column name="code" value="LECTEUR"/>
            <column name="libelle" value="Lecteur (diffusion)"/>
            <column name="systeme" valueBoolean="false"/>
            <column name="acces_global" valueBoolean="false"/>
        </insert>
        <insert tableName="role_permission">
            <column name="role_id" value="0192a000-0000-7000-8000-000000000005"/>
            <column name="permission_id" value="0192b000-0000-7000-8000-000000000001"/>
        </insert>
        <!--
            Retour arrière (ANO-E8-004) : supprimer le rôle supprime ses
            habilitations, c'est-à-dire toutes les diffusions de documents validés
            (et toute attribution manuelle du rôle). S'il en existe, le retour
            arrière est REFUSÉ avec leur décompte, avant toute suppression, sauf
            décision explicite de l'exploitant (ged.retour_arriere_avec_perte = oui,
            DEPLOIEMENT.md §8), comme 202610021120 (ANO-E8-003). Le bloc rollback
            n'entre pas dans la somme de contrôle.
        -->
        <rollback>
            <sql splitStatements="false"><![CDATA[DO $garde$
DECLARE
    diffusions INTEGER; composition INTEGER;
BEGIN
    SELECT count(*) INTO diffusions FROM ${database.defaultSchemaName}.habilitation
     WHERE role_id = '0192a000-0000-7000-8000-000000000005';
    -- Permissions ajoutées au rôle depuis l'écran des rôles (livré : Consulter seule).
    SELECT count(*) INTO composition FROM ${database.defaultSchemaName}.role_permission
     WHERE role_id = '0192a000-0000-7000-8000-000000000005'
       AND permission_id <> '0192b000-0000-7000-8000-000000000001';
    IF (diffusions + composition) > 0
       AND coalesce(current_setting('ged.retour_arriere_avec_perte', true), '') <> 'oui' THEN
        RAISE EXCEPTION 'Retour arrière du rôle Lecteur (diffusion) refusé : il perdrait % habilitation(s) du rôle (diffusions de documents validés) et % permission(s) ajoutée(s) au rôle. Rien n''a été supprimé. Décision explicite requise : ged.retour_arriere_avec_perte = oui (DEPLOIEMENT.md §8).',
            diffusions, composition;
    END IF;
END
$garde$]]></sql>
            <delete tableName="habilitation"><where>role_id = '0192a000-0000-7000-8000-000000000005'</where></delete>
            <delete tableName="role_permission"><where>role_id = '0192a000-0000-7000-8000-000000000005'</where></delete>
            <delete tableName="role"><where>id = '0192a000-0000-7000-8000-000000000005'</where></delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
