<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        logicalFilePath="db/changelog/changesets/202609301005_statut_conservation_document_provisoire.xml">

    <!--
        PROVISOIRE, en attendant la fusion du lot modèle de dev1 : les colonnes
        de conservation du document (statut_conservation, archive_le,
        archive_par) sont posées par le changeset 202609301000 de dev1 (avec la
        clé étrangère vers utilisateur, et le même drapeau sur noeud). Celui-ci
        les crée À L'IDENTIQUE pour la branche du cycle de vie, et s'efface
        (MARK_RAN) dès qu'elles existent : à la fusion, il ne fait rien.
    -->
    <changeSet id="202609301005-1" author="ged">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="document" columnName="statut_conservation"/>
            </not>
        </preConditions>
        <comment>Statut de conservation du document (provisoire, contrat du lot modèle).</comment>
        <addColumn tableName="document">
            <column name="statut_conservation" type="VARCHAR(10)" defaultValue="ACTIF"><constraints nullable="false"/></column>
            <column name="archive_le" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="archive_par" type="UUID"/>
        </addColumn>
        <sql>ALTER TABLE ${database.defaultSchemaName}.document ADD CONSTRAINT ck_document_statut_conservation CHECK (statut_conservation IN ('ACTIF', 'ARCHIVE') AND ((statut_conservation = 'ARCHIVE') = (archive_le IS NOT NULL)))</sql>
        <createIndex indexName="idx_document_statut_conservation" tableName="document"><column name="statut_conservation"/></createIndex>
        <createIndex indexName="idx_document_archive_par" tableName="document"><column name="archive_par"/></createIndex>
        <rollback>
            <dropIndex tableName="document" indexName="idx_document_archive_par"/>
            <dropIndex tableName="document" indexName="idx_document_statut_conservation"/>
            <sql>ALTER TABLE ${database.defaultSchemaName}.document DROP CONSTRAINT ck_document_statut_conservation</sql>
            <dropColumn tableName="document">
                <column name="archive_par"/>
                <column name="archive_le"/>
                <column name="statut_conservation"/>
            </dropColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
