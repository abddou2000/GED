<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lot E5 (dev3) — rattachement des versions de document au stockage chiffré
  (§6.1.1, §6.1.4, §6.1.5).

  À INTÉGRER par dev1, APRÈS la création de version_document (modèle UUID) et
  de cle_fichier. Schéma « expand » : les colonnes sont nullables tant que la
  reprise des fichiers en clair n'a pas renseigné toutes les lignes ; le
  changeset « contract » (NOT NULL, retrait de l'ancien chemin en clair) sera
  écrit après la reprise en production. Voir docs/conformite/suivi/dev3.md.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="202609261205_version_document_fichier" author="dev3">
        <preConditions onFail="HALT">
            <tableExists tableName="version_document"/>
            <tableExists tableName="cle_fichier"/>
        </preConditions>
        <comment>Fichier chiffré, empreinte SHA-256, type réel et taille de chaque version</comment>

        <addColumn tableName="version_document">
            <column name="fichier_id" type="uuid"
                    remarks="Fichier chiffré de la version (= cle_fichier.id, nom aa/bb/&lt;uuid&gt;.enc)"/>
            <column name="empreinte" type="char(64)"
                    remarks="SHA-256 du contenu en clair, hexadécimal minuscule (§6.1.4)"/>
            <column name="type_mime" type="varchar(127)"
                    remarks="Type réel détecté par le contenu (Apache Tika) au dépôt"/>
            <column name="taille_octets" type="bigint" remarks="Taille du contenu en clair"/>
        </addColumn>

        <addForeignKeyConstraint constraintName="fk_version_document_fichier_id"
                                 baseTableName="version_document" baseColumnNames="fichier_id"
                                 referencedTableName="cle_fichier" referencedColumnNames="id"/>
        <addUniqueConstraint constraintName="uk_version_document_fichier_id"
                             tableName="version_document" columnNames="fichier_id"/>
        <sql>
            ALTER TABLE version_document
                ADD CONSTRAINT ck_version_document_empreinte CHECK (empreinte ~ '^[0-9a-f]{64}$');
            ALTER TABLE version_document
                ADD CONSTRAINT ck_version_document_taille_octets CHECK (taille_octets &gt;= 0);
        </sql>

        <rollback>
            <sql>
                ALTER TABLE version_document DROP CONSTRAINT IF EXISTS ck_version_document_taille_octets;
                ALTER TABLE version_document DROP CONSTRAINT IF EXISTS ck_version_document_empreinte;
            </sql>
            <dropUniqueConstraint tableName="version_document" constraintName="uk_version_document_fichier_id"/>
            <dropForeignKeyConstraint baseTableName="version_document" constraintName="fk_version_document_fichier_id"/>
            <dropColumn tableName="version_document">
                <column name="taille_octets"/>
                <column name="type_mime"/>
                <column name="empreinte"/>
                <column name="fichier_id"/>
            </dropColumn>
        </rollback>
    </changeSet>
</databaseChangeLog>
