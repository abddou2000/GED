<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lot E5 (dev3) — table cle_fichier (§6.1.2 du dossier technique).

  À INTÉGRER par dev1 dans le changelog maître : ce fichier est volontairement
  hors du changelog (en cours de création par dev1). Ordre : après la création
  des rôles, avant 202609261205_version_document_fichier.xml.

  Une ligne par fichier chiffré (version de document, copie de conservation,
  aperçu en cache) : sa clé de données (DEK), enveloppée par la clé maîtresse
  (KEK) identifiée par kek_id. La DEK n'est JAMAIS stockée en clair.
  Supprimer la ligne = destruction cryptographique du fichier (§12.5).
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="202609261200_cle_fichier" author="dev3">
        <comment>Clés de données enveloppées des fichiers chiffrés (AES-256-GCM)</comment>
        <createTable tableName="cle_fichier"
                     remarks="DEK enveloppée par la KEK de chaque fichier chiffré ; supprimer la ligne rend le fichier illisible">
            <column name="id" type="uuid" remarks="Identifiant du fichier stocké (nom aa/bb/&lt;uuid&gt;.enc)">
                <constraints primaryKey="true" primaryKeyName="pk_cle_fichier" nullable="false"/>
            </column>
            <column name="dek_enveloppee" type="bytea" remarks="IV (12) || DEK chiffrée (32) || étiquette GCM (16)">
                <constraints nullable="false"/>
            </column>
            <column name="kek_id" type="varchar(64)" remarks="Alias de la KEK dans le keystore ou identifiant KMS">
                <constraints nullable="false"/>
            </column>
            <column name="algorithme" type="varchar(32)" defaultValue="AES-256-GCM"
                    remarks="Algorithme de chiffrement du fichier">
                <constraints nullable="false"/>
            </column>
            <column name="cree_le" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modifie_le" type="timestamptz" remarks="Dernier réenveloppement (rotation de KEK)"/>
        </createTable>

        <sql>
            ALTER TABLE cle_fichier
                ADD CONSTRAINT ck_cle_fichier_algorithme CHECK (algorithme IN ('AES-256-GCM'));
            ALTER TABLE cle_fichier
                ADD CONSTRAINT ck_cle_fichier_dek_enveloppee CHECK (octet_length(dek_enveloppee) BETWEEN 28 AND 1024);
        </sql>

        <!-- La rotation parcourt les DEK qui ne sont pas sous la KEK active. -->
        <createIndex tableName="cle_fichier" indexName="idx_cle_fichier_kek_id">
            <column name="kek_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="cle_fichier"/>
        </rollback>
    </changeSet>

    <!--
      Droits : l'application lit, insère, met à jour (rotation) et supprime
      (purge) ; la lecture seule n'a pas à voir les clés, même enveloppées.
      Exécuté seulement si les rôles du lot de dev1 existent.
    -->
    <changeSet id="202609261200_cle_fichier_droits" author="dev3">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM pg_roles WHERE rolname = 'ged_app'</sqlCheck>
        </preConditions>
        <sql>GRANT SELECT, INSERT, UPDATE, DELETE ON cle_fichier TO ged_app;</sql>
        <rollback>
            <sql>REVOKE ALL ON cle_fichier FROM ged_app;</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
