    <!--
        Prérequis de la stack imposée (§2.2.1), vérifiés à CHAQUE exécution :
        PostgreSQL 16 ou plus, et configuration de recherche plein texte `arabic`
        présente (le lot E6 en dépend). Un serveur non conforme arrête le
        déploiement avant toute écriture, au lieu d'échouer plus tard sur une
        recherche.
    -->
    <preConditions onFail="HALT" onError="HALT">
        <dbms type="postgresql"/>
        <sqlCheck expectedResult="1">SELECT CASE WHEN current_setting('server_version_num')::int &gt;= 160000 THEN 1 ELSE 0 END</sqlCheck>
        <sqlCheck expectedResult="1">SELECT count(*) FROM pg_catalog.pg_ts_config WHERE cfgname = 'arabic'</sqlCheck>
    </preConditions>

