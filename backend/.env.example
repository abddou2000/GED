# ============================================================
#  GED — variables d'environnement
#  Copiez ce fichier en `.env` (non versionné) ou exportez ces variables
#  dans l'environnement du service. NE COMMITEZ JAMAIS les vraies valeurs.
# ============================================================

# ------------------------------------------------------------
# Exploitation : journalisation et supervision (exploitation.yml)
# ------------------------------------------------------------
# Modèle complet d'un environnement déployé : deploiement/systemd/ged.env.exemple.
#
# GED_ENVIRONNEMENT       dev | uat | prod, étiquette des métriques.
# GED_MANAGEMENT_PORT     port de l'Actuator (santé, Prometheus). Défaut 8081.
# GED_MANAGEMENT_ADRESSE  interface d'écoute de ce port. Défaut 127.0.0.1 ;
#                         en UAT/PROD, l'interface du réseau d'administration.
# GED_PROXYS_DE_CONFIANCE adresses (ou CIDR) des proxys dont X-Forwarded-For est
#                         cru pour l'IP des journaux : l'adresse de NGINX.
# GED_LOG_REPERTOIRE      répertoire des journaux (uat/prod). Défaut ./logs.
# GED_LOG_RETENTION_JOURS rétention des journaux techniques. Défaut 90.
# GED_LOG_TAILLE_MAX      taille déclenchant une rotation. Défaut 100MB.
# LOGGING_LEVEL_COM_IPT_GED  niveau de log ponctuel (DEBUG en DEV/UAT).
# GED_LDAP_URLS           contrôleurs de domaine : voir la section Annuaire ci-dessous.
# GED_SONDE_ANTIVIRUS     supervision de clamd. Défaut : suit ged.fichiers.antivirus.actif.
# GED_OCR_OBJECTIF_DISPONIBILITE  délai dépôt -> recherche au-delà duquel on alerte. Défaut 24h.
# GED_AUDIT_EXPORT_SCELLEMENTS  fichier (ajout seul, support distinct) des scellements
#                         du journal d'audit. Défaut ./audit/scellements.jsonl.
# GED_AUDIT_PLANIFICATION scellement et vérification planifiés (false sur une instance
#                         secondaire). Défaut true.
# GED_AUDIT_RETENTION_ANNEES  rétention du journal d'audit. Défaut 10 (aucune purge automatique).

# ------------------------------------------------------------
# Annuaire (LDAPS) — lot E2, dossier technique §3.3 ; décisions D1 à D4
# ------------------------------------------------------------
# Contrôleurs de domaine, par ordre de préférence, séparés par des virgules.
# ldaps:// obligatoire hors dev/test (ldap:// = refus de démarrer). Un seul
# contrôleur suffit ; le suivant prend le relais si le premier ne répond pas.
GED_LDAP_URLS=ldaps://dc1.marchicamed.ma:636
# Base de recherche des utilisateurs.
GED_LDAP_BASE=DC=marchicamed,DC=ma
# Compte de service EN LECTURE SEULE (DN), limité à la recherche d'utilisateurs.
GED_LDAP_COMPTE_SERVICE=CN=svc-ged-ldap,OU=Services,DC=marchicamed,DC=ma
# Son secret : soit la valeur, soit (préférable) un fichier déposé par le coffre
# de MMED, relu à chaud quand il change (rotation sans redémarrage).
GED_LDAP_MOT_DE_PASSE=
GED_LDAP_MOT_DE_PASSE_FICHIER=
# Magasin de confiance contenant la chaîne de certificats des contrôleurs.
GED_LDAP_TRUSTSTORE=
GED_LDAP_TRUSTSTORE_MOT_DE_PASSE=
GED_LDAP_TRUSTSTORE_TYPE=PKCS12

# ------------------------------------------------------------
# Jeton d'accès JWT RS256 (15 min) — §3.4.1
# ------------------------------------------------------------
# Magasin PKCS#12 contenant la clé privée RSA (3072 bits conseillés, 2048 min.)
# et son certificat. HORS du dépôt, distinct par environnement. Absent = refus
# de démarrer (hors dev/test, qui tirent une paire éphémère). Génération :
#   keytool -genkeypair -alias ged-jwt -keyalg RSA -keysize 3072 -validity 825 #           -storetype PKCS12 -keystore ged-jwt.p12 -dname "CN=ged-jwt"
GED_JWT_KEYSTORE=
GED_JWT_KEYSTORE_MOT_DE_PASSE=
GED_JWT_ALIAS=ged-jwt

# ------------------------------------------------------------
# Session (jeton de renouvellement en cookie HttpOnly) — §3.4.1, risque R26
# ------------------------------------------------------------
# Durée de vie ABSOLUE d'une session. 8h au dossier V3 ; 4h recommandées : la GED
# ne relit pas l'état des comptes dans l'annuaire (décision D1), un compte
# désactivé garde donc sa session jusqu'à cette borne — sauf révocation par
# l'Administrateur (écran Sessions). L'inactivité maximale est de 30 minutes.
GED_SESSION_DUREE_ABSOLUE=8h

# ------------------------------------------------------------
# Premier Administrateur
# ------------------------------------------------------------
# sAMAccountName (séparés par des virgules) recevant le rôle Administrateur à
# leur PREMIÈRE connexion. Toute autre identité est provisionnée sans rôle ;
# ensuite, les rôles ne se gèrent que dans la GED.
GED_ADMINISTRATEURS=

# Domaine des adresses dérivées « prenom.nom@domaine », utilisé uniquement pour
# rattacher une identité à une fiche employé reprise de l'ancienne base.
GED_DOMAINE_COURRIEL=marchica.ma

# ------------------------------------------------------------
# Autorisation (lot E3)
# ------------------------------------------------------------
# Nombre de sujets (utilisateurs, applications) dont les droits résolus sont
# gardés en mémoire. Défaut 1000 ; l'invalidation est immédiate à chaque
# modification de droit (compteur version_habilitations en base).
GED_AUTORISATION_CACHE_TAILLE=1000

# ------------------------------------------------------------
# GED_ORIGINES — origines autorisées à appeler l'API (CORS), séparées par des virgules
# ------------------------------------------------------------
# Défaut hors prod : http://localhost:*,http://127.0.0.1:*
# En prod, mettre les domaines réels du frontend (un WARN est journalisé si le
# repli localhost reste actif).
GED_ORIGINES=https://ged.example.ma

# ------------------------------------------------------------
# Base de données — PostgreSQL 16 ou plus, dans TOUS les profils
# ------------------------------------------------------------
# Rôles et schémas : scripts/db/creer-roles.sql (une fois par serveur), puis
# scripts/db/preparer-base.sql (une fois par base). Voir DEPLOIEMENT.md.
#
# Nom de la base selon le profil :
#   dev  : DB_NAME, défaut ged_dev1
#   test : DB_NAME_TEST, sinon <DB_NAME>_test (défaut ged_dev1_test). La suite
#          de tests VIDE ce schéma à chaque exécution : ne jamais y mettre une
#          base qui compte.
#   prod : DB_NAME, défaut ged
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ged
# Chiffrement de la connexion à la base : prefer en dev/test, verify-full par
# défaut en uat et prod (certificat du serveur vérifié contre l'autorité MMED).
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/etc/ged/pki/postgresql-ca.crt
# DB_NAME_TEST=ged_dev1_test

# Compte applicatif ged_app : DML seulement (SELECT, INSERT, UPDATE, DELETE).
# C'est le seul compte que l'application utilise en fonctionnement.
DB_USER=ged_app
DB_PASSWORD=

# Compte propriétaire ged_owner : utilisé UNIQUEMENT par Liquibase. En uat et en
# prod, Liquibase ne tourne PAS au démarrage (spring.liquibase.enabled=false) :
# les migrations passent par le script de déploiement, avec ce compte.
# SPRING_LIQUIBASE_ENABLED=true rétablit la migration au démarrage.
DB_OWNER_USER=ged_owner
DB_OWNER_PASSWORD=

# Schémas (défauts : ged pour les tables, ged_liquibase pour le registre des
# migrations, inaccessible à ged_app).
# DB_SCHEMA=ged
# DB_SCHEMA_LIQUIBASE=ged_liquibase

# ============================================================
#  Stockage sécurisé des fichiers (lot E5, §6.1 du dossier technique)
# ============================================================

# ------------------------------------------------------------
# GED_KEYSTORE_CHEMIN — keystore PKCS#12 des clés maîtresses (KEK)
# ------------------------------------------------------------
# Obligatoire en prod (absent = refus de démarrer). Distinct pour DEV, UAT et
# PROD. JAMAIS sous GED_STOCKAGE_RACINE : une clé rangée avec les fichiers
# qu'elle chiffre ne les protège pas (l'application refuse de démarrer).
# Création initiale (une fois, par l'exploitant) : démarrer une fois avec
# --ged.fichiers.cles.creer-si-absent=true, puis retirer l'option.
# SAUVEGARDE : sans ce keystore et sa phrase secrète, le fonds documentaire
# sauvegardé est irrécupérable. Le sauvegarder après chaque rotation de KEK.
GED_KEYSTORE_CHEMIN=

# ------------------------------------------------------------
# GED_KEYSTORE_MDP — phrase secrète du keystore
# ------------------------------------------------------------
# Injectée par le coffre de secrets de l'environnement. Obligatoire partout
# hors dev/test (absente = refus de démarrer).
GED_KEYSTORE_MDP=

# ------------------------------------------------------------
# GED_STOCKAGE_RACINE — racine du référentiel chiffré (/<racine>/aa/bb/<uuid>.enc)
# GED_CACHE_APERCU_RACINE — racine du cache chiffré des aperçus bureautiques
# ------------------------------------------------------------
GED_STOCKAGE_RACINE=
GED_CACHE_APERCU_RACINE=

# ------------------------------------------------------------
# GED_CLAMAV_HOTE / GED_CLAMAV_PORT — démon clamd (INSTREAM en TCP)
# ------------------------------------------------------------
# Échec fermé : clamd injoignable = dépôt refusé (503). Côté clamd.conf,
# StreamMaxLength doit valoir au moins 200M (plafond de plateforme).
# Défaut : localhost:3310.
GED_CLAMAV_HOTE=
GED_CLAMAV_PORT=

# ------------------------------------------------------------
# GED_ANTIVIRUS_ACTIF — profil dev uniquement
# ------------------------------------------------------------
# false par défaut en dev (poste sans ClamAV) ; ignoré ailleurs : la prod
# refuse de démarrer avec l'antivirus désactivé.
GED_ANTIVIRUS_ACTIF=

# ------------------------------------------------------------
# GED_LIBREOFFICE — commande LibreOffice pour la prévisualisation bureautique
# GED_APERCU_TRAVAIL — répertoire de travail de la conversion (tmpfs en prod)
# ------------------------------------------------------------
# LibreOffice absent : la prévisualisation bureautique est désactivée (503),
# PDF et images restent prévisualisables. Défaut : soffice (dans le PATH).
GED_LIBREOFFICE=
GED_APERCU_TRAVAIL=

# ------------------------------------------------------------
# Notifications (DAT §12.9) — relais SMTP de MMED
# ------------------------------------------------------------
# GED_SMTP_HOTE / GED_SMTP_PORT — relais SMTP (défaut localhost:25)
# GED_SMTP_AUTH — true si le relais exige une authentification
# GED_SMTP_UTILISATEUR / GED_SMTP_MOT_DE_PASSE — compte d'envoi (secret : jamais ici en prod)
# GED_SMTP_STARTTLS — TLS exigé vers le relais (true par défaut, DAT §6.2.1)
# GED_NOTIFICATION_EXPEDITEUR — adresse d'expédition des e-mails
# GED_URL_APPLICATION — adresse publique du front, pour le lien de l'e-mail
# Relais injoignable : trois tentatives puis état ECHEC ; la notification
# reste visible dans l'application.
GED_SMTP_HOTE=
GED_SMTP_PORT=
GED_SMTP_AUTH=
GED_SMTP_UTILISATEUR=
GED_SMTP_MOT_DE_PASSE=
GED_SMTP_STARTTLS=
GED_NOTIFICATION_EXPEDITEUR=
GED_URL_APPLICATION=

# ------------------------------------------------------------
# GED_CONSERVATION_TRAVAIL — copie de conservation PDF/A-2 (lot E7, §6.1.4)
# ------------------------------------------------------------
# Répertoire de travail de la conversion à l'archivage (tmpfs en prod : la
# version y est déchiffrée le temps de la conversion). LibreOffice 7.4 ou plus
# récent (export PDF/A-2 en ligne de commande) ; validation par veraPDF,
# embarqué dans l'application. Défaut : <tmp>/ged-conservation.
GED_CONSERVATION_TRAVAIL=

# ------------------------------------------------------------
# GED_TESSERACT / GED_TESSDATA — OCR asynchrone (lot E6)
# ------------------------------------------------------------
# Binaire Tesseract 5 (appelé depuis Java, aucun Python) et répertoire des
# modèles fra et ara (livrés dans backend/tessdata). Défauts : chemin Windows
# du poste de développement, ./tessdata. Linux : /usr/bin/tesseract.
GED_TESSERACT=
GED_TESSDATA=
