#!/usr/bin/env bash
# Adaptateur de unzip pour Git Bash : l'UnZip 6.00 de MSYS2 est compilé pour que « * »
# s'arrête au séparateur « / » (comportement de -W), alors que l'UnZip des
# distributions Linux fait traverser les répertoires à « * ». Pour reproduire le
# comportement du serveur cible, un motif terminé par « /* » devient « /** ».
# Recette de deployer.sh (T-092) seulement ; aucun autre changement.
args=()
for a in "$@"; do
  if [[ "$a" == */\* ]]; then args+=("${a%\*}**"); else args+=("$a"); fi
done
exec /usr/bin/unzip "${args[@]}"
