<?xml version="1.0" encoding="UTF-8"?>
<!-- Autotest E1-R01 : un changeset SQL sans <rollback> doit faire échouer le retour arrière. -->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="at-1" author="qa">
    <createTable tableName="qa_table_auto"><column name="id" type="uuid"/></createTable>
  </changeSet>
  <changeSet id="at-2" author="qa">
    <sql>CREATE TABLE qa_table_sql (id uuid)</sql>
  </changeSet>
</databaseChangeLog>
