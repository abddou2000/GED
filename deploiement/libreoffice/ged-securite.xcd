<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration imposée de LibreOffice pour la GED (P-12, OWASP A10 ; ANO-E11-002).

  LibreOffice convertit des documents DÉPOSÉS (aperçus, copies PDF/A). Un tel
  document peut référencer une ressource externe (image liée, lien) que
  LibreOffice tenterait de charger : c'est une requête sortante dont le
  déposant choisit la destination. Deux parades, indépendantes :
    1. ce fichier : aucune ressource liée d'un document non approuvé n'est
       chargée, aucune macro n'est exécutée ;
    2. le filtre de sortie systemd du service (processus enfants compris) :
       ged-backend.service.d/sorties.conf.

  Installation (couche de configuration partagée, lue avant le profil
  utilisateur ; « finalized » : le profil jetable de chaque conversion ne
  peut pas la contredire) :
    Debian, Ubuntu : install -m 0644 ged-securite.xcd /usr/lib/libreoffice/share/registry/
    RHEL et dérivés : install -m 0644 ged-securite.xcd /usr/lib64/libreoffice/share/registry/
  puis aucune relance nécessaire : chaque conversion démarre un nouveau soffice.

  Vérification à l'installation (docs/exploitation/EXPLOITATION.md §12) :
  convertir un document de test qui lie une image distante et constater
  qu'aucune connexion n'est tentée (journal du filtre, « ss -tnp »).
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Security">
      <node oor:name="Scripting">
        <!-- Ressources liées (images, objets) d'un document hors emplacement approuvé : bloquées. -->
        <prop oor:name="BlockUntrustedRefererLinks" oor:finalized="true">
          <value>true</value>
        </prop>
        <!-- Aucune macro, quel que soit le document. -->
        <prop oor:name="DisableMacrosExecution" oor:finalized="true">
          <value>true</value>
        </prop>
        <prop oor:name="MacroSecurityLevel" oor:finalized="true">
          <value>3</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
