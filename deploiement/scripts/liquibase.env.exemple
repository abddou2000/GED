# =====================================================================
#  /etc/ged/liquibase.env — compte PROPRIÉTAIRE ged_owner (DAT 4.2.3, 10.1)
#  root:root, 0400. Lu par deployer.sh seulement, pour les migrations :
#  l'application ne dispose jamais de ces identifiants.
# =====================================================================
DB_HOST=ged-db.marchica.local
DB_PORT=5432
DB_NAME=ged
DB_SCHEMA=ged
DB_SCHEMA_LIQUIBASE=ged_liquibase
DB_OWNER_USER=ged_owner
DB_OWNER_PASSWORD=
# Liaison chiffrée, serveur authentifié (DAT 6.2.1).
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/ged/tls/pg-ca.pem
