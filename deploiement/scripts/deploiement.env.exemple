# =====================================================================
#  /etc/ged/deploiement.env — paramètres du script de déploiement
#  root:root, 0400. Un fichier par environnement.
# =====================================================================
# URL publique (derrière NGINX) utilisée par le test de fumée.
GED_URL_PUBLIQUE=https://ged.marchica.ma
# Port de management : par défaut GED_MANAGEMENT_ADRESSE:GED_MANAGEMENT_PORT de ged.env.
# GED_URL_MANAGEMENT=http://10.0.0.21:8081

# Compte technique du test de fumée : droits sur le seul espace « Tests de
# fumée ». Identifiant d'annuaire après E2 (UID AD, décision D2).
GED_FUMEE_IDENTIFIANT=
GED_FUMEE_MDP=
GED_FUMEE_TYPE_DOCUMENT=

# Liquibase CLI installé sur ce serveur, même version mineure que celle du JAR.
LIQUIBASE_CMD=/opt/liquibase/liquibase
