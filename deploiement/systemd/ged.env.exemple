# =====================================================================
#  /etc/ged/ged.env — configuration d'un environnement (DEV, UAT ou PROD)
#
#  Modèle versionné SANS AUCUN SECRET. Sur le serveur :
#    install -o ged -g ged -m 0400 ged.env /etc/ged/ged.env
#  Un fichier par environnement, jamais recopié de l'un à l'autre : les
#  secrets sont distincts d'un environnement à l'autre (DAT 10.1).
#  Le détail de chaque variable applicative est dans backend/.env.example.
# =====================================================================

# --- Environnement ------------------------------------------------------
# dev | uat | prod : profil Spring actif, et contrôle du script de
# déploiement (il refuse de déployer si l'argument ne correspond pas).
GED_PROFIL=prod
GED_ENVIRONNEMENT=prod

# --- JVM -------------------------------------------------------------------
# 8 Go de mémoire sur le serveur d'application (DAT 6.6) : 4 Go de tas.
# Valeur entre guillemets : le fichier est lu par systemd ET par deployer.sh (bash).
# Temporaires de la JVM (PDFBox, POI, Tika…) sur le tmpfs : ils peuvent
# contenir des extraits de documents en clair.
JAVA_OPTS="-Xms1g -Xmx4g -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/var/lib/ged/tmpfs/java -Dfile.encoding=UTF-8 -Duser.timezone=UTC"

# --- Réseau ------------------------------------------------------------------
SERVER_PORT=8080
# Port de management (Actuator : santé, métriques Prometheus), sur
# l'interface du réseau d'administration seulement — jamais relayé par NGINX.
GED_MANAGEMENT_PORT=8081
GED_MANAGEMENT_ADRESSE=10.0.0.21
# Adresse du serveur NGINX : seul autorisé à poser X-Forwarded-For.
GED_PROXYS_DE_CONFIANCE=10.0.0.10
GED_ORIGINES=https://ged.marchica.ma

# --- Base PostgreSQL (serveur distinct, DAT 10.2) ------------------------------
DB_HOST=ged-db.marchica.local
DB_PORT=5432
DB_NAME=ged
DB_SCHEMA=ged
# Compte applicatif ged_app : DML seulement (DAT 4.2.3).
DB_USER=ged_app
DB_PASSWORD=
# Liaison chiffrée vers la base (DAT 6.2.1), si le pilote la lit ici :
# voir docs/exploitation/EXPLOITATION.md, § « Chiffrement des liaisons ».
# Les migrations sont appliquées par le script de déploiement avec le compte
# propriétaire (/etc/ged/liquibase.env, lisible par root seul) : l'application
# n'a pas besoin des identifiants de ged_owner à l'exécution.
SPRING_LIQUIBASE_ENABLED=false

# --- Fichiers (lot E5, DAT 6.1) -------------------------------------------------
# Référentiel chiffré aa/bb/<uuid>.enc : volume persistant, sauvegardé APRÈS la base.
GED_STOCKAGE_RACINE=/var/lib/ged/fichiers
# Cache chiffré des aperçus bureautiques (reconstructible, non sauvegardé).
GED_CACHE_APERCU_RACINE=/var/lib/ged/cache-apercu
# Keystore PKCS#12 des clés maîtresses (KEK) : HORS du référentiel de fichiers,
# dans un répertoire propre (ged, 0700) que l'application réécrit à chaque
# rotation de KEK (fichier 0600) ; sauvegardé séparément des fichiers (DAT 6.5).
# Obligatoires hors DEV : sans eux, le back-end refuse de démarrer.
GED_KEYSTORE_CHEMIN=/var/lib/ged/cles/ged-kek.p12
GED_KEYSTORE_MDP=
# Fichiers en clair éphémères, sur le tmpfs /var/lib/ged/tmpfs (ged-tmpfs.exemple.fstab) :
#  - corps multipart reçus par Tomcat, le temps de la requête ;
SPRING_SERVLET_MULTIPART_LOCATION=/var/lib/ged/tmpfs/multipart
#  - pages rendues pour l'OCR : temporaires de la JVM (java.io.tmpdir, JAVA_OPTS) ;
#  - conversions LibreOffice des aperçus.
GED_APERCU_TRAVAIL=/var/lib/ged/tmpfs/apercu
# Moteur OCR : binaire Tesseract 5 appelé depuis Java (décision D5), modèles fra et ara.
GED_TESSERACT=/usr/bin/tesseract
GED_TESSDATA=/opt/ged/tessdata
# Antivirus (échec fermé) : clamd joignable en TCP depuis ce serveur.
GED_CLAMAV_HOTE=127.0.0.1
GED_CLAMAV_PORT=3310

# --- Journalisation (DAT 7.3.1) ------------------------------------------------
GED_LOG_REPERTOIRE=/var/log/ged
# Diagnostic ponctuel en UAT (jamais durablement en PROD) :
# LOGGING_LEVEL_COM_IPT_GED=DEBUG

# --- Supervision (DAT 6.7) -------------------------------------------------------
# Objectif de délai dépôt -> disponibilité en recherche (décision D6).
GED_OCR_OBJECTIF_DISPONIBILITE=24h

# --- Journal d'audit (DAT 7.4) ---------------------------------------------------
# Copie hors base des scellements horaires : fichier en AJOUT SEUL sur un
# support distinct (chattr +a), voir docs/exploitation/EXPLOITATION.md § 8.
GED_AUDIT_EXPORT_SCELLEMENTS=/var/lib/ged/audit-scellements/scellements.jsonl
# Une seule instance scelle (les autres : false).
GED_AUDIT_PLANIFICATION=true

# --- Identité : annuaire LDAPS et sessions (lot E2, DAT 3) -------------------------
# Un ou plusieurs contrôleurs de domaine, séparés par des virgules (décision
# D4 : un seul aujourd'hui) ; liaison chiffrée LDAPS (DAT 6.2.1).
GED_LDAP_URLS=ldaps://dc01.marchica.local:636
GED_LDAP_BASE=DC=marchica,DC=local
# Compte de service en lecture seule ; son mot de passe de préférence dans un
# fichier 0400 (GED_LDAP_MOT_DE_PASSE_FICHIER) plutôt qu'ici.
GED_LDAP_COMPTE_SERVICE=CN=svc-ged-ldap,OU=Services,DC=marchica,DC=local
GED_LDAP_MOT_DE_PASSE_FICHIER=/etc/ged/secrets/ldap-service.mdp
# Autorité de certification des contrôleurs de domaine.
GED_LDAP_TRUSTSTORE=/etc/ged/tls/ldap-truststore.p12
GED_LDAP_TRUSTSTORE_MOT_DE_PASSE=
GED_LDAP_TRUSTSTORE_TYPE=PKCS12
# Clé privée RS256 de signature des jetons (coffre de l'environnement, 0400,
# propriété ged) : sauvegardée avec les clés (docs/exploitation/RESTAURATION.md).
GED_JWT_KEYSTORE=/etc/ged/cles/ged-jwt.p12
GED_JWT_KEYSTORE_MOT_DE_PASSE=
GED_JWT_ALIAS=ged-jwt
# Durée absolue d'une session (revue technique, risque R1).
GED_SESSION_DUREE_ABSOLUE=8h
# Identifiants AD (sAMAccountName) des administrateurs de la GED.
GED_ADMINISTRATEURS=
GED_DOMAINE_COURRIEL=marchica.ma

# --- Notifications : relais SMTP de MMED (DAT 12.9) -----------------------------
# TLS exigé vers le relais (STARTTLS). Mot de passe du compte d'envoi : à
# renseigner ici seulement si le relais exige une authentification (fichier 0400).
GED_SMTP_HOTE=smtp.marchica.local
GED_SMTP_PORT=25
GED_SMTP_STARTTLS=true
GED_SMTP_AUTH=false
GED_SMTP_UTILISATEUR=
GED_SMTP_MOT_DE_PASSE=
GED_NOTIFICATION_EXPEDITEUR=ged-ne-pas-repondre@marchica.ma
GED_URL_APPLICATION=https://ged.marchica.ma
