# ============================================================
#  Modules métier activés sur ce serveur (DAT 9.3, T-088)
#  À installer en /etc/ged/modules.env (root:ged, 0640) ; lu par le service
#  après ged.env. Tenu par deployer.sh --activer-module / --desactiver-module.
#  Absent ou vide : tous les modules sont actifs (production).
#  Procédure UAT : DEPLOIEMENT.md § 10.
# ============================================================
GED_MODULES_OCR_ACTIF=true
GED_MODULES_WORKFLOW_ACTIF=true
GED_MODULES_CYCLEDEVIE_ACTIF=true
GED_MODULES_EXPORT_ACTIF=true
GED_MODULES_NOTIFICATIONS_ACTIF=true
GED_MODULES_INTEGRATION_ACTIF=true
