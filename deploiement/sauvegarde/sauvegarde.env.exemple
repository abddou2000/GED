# =====================================================================
#  /etc/ged/sauvegarde.env — configuration des sauvegardes (DAT 6.5)
#  root:root, 0400. Aucun mot de passe ici : celui du compte de sauvegarde
#  est dans le fichier PGPASSFILE (0400), jamais dans l'environnement.
# =====================================================================

# --- Base (lue à distance, depuis le serveur d'application) -----------------
PGHOST=ged-db.marchica.local
PGPORT=5432
PGDATABASE=ged
# Compte dédié : membre de pg_read_all_data (pg_dump) et doté de l'attribut
# REPLICATION (pg_basebackup). Ni propriétaire ni applicatif.
PGUSER=ged_sauvegarde
PGPASSFILE=/etc/ged/sauvegarde.pgpass
# Liaison chiffrée et serveur authentifié (DAT 6.2.1).
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ged/tls/pg-ca.pem

# --- Destinations : supports DISTINCTS du serveur (DAT 6.5) -------------------
# Base et fichiers chiffrés.
GED_SAUVEGARDE_DESTINATION=/mnt/sauvegarde-ged
# Clés : support distinct de celui des fichiers — une sauvegarde de fichiers
# chiffrés et de leurs clés au même endroit ne protège plus rien.
GED_SAUVEGARDE_CLES_DESTINATION=/mnt/sauvegarde-cles-ged
# Clé publique GPG du responsable sécurité de MMED : l'archive des clés est
# chiffrée pour lui ; la clé privée n'est JAMAIS sur ce serveur.
GED_SAUVEGARDE_GPG_DESTINATAIRE=securite-si@marchica.ma

# --- Sources -------------------------------------------------------------------
GED_STOCKAGE_RACINE=/var/lib/ged/fichiers
GED_KEYSTORE_CHEMIN=/var/lib/ged/cles/ged-kek.p12
# Secrets de l'environnement joints à l'archive des clés (DAT 6.5 : « clés,
# cle_fichier, secrets »), dont le mot de passe du keystore.
GED_SAUVEGARDE_SECRETS="/etc/ged/ged.env /etc/ged/liquibase.env"
# Schéma de l'application (table cle_fichier).
GED_SCHEMA=ged

# --- Rétention (DAT 6.5) --------------------------------------------------------
# 30 jours en ligne ; la sauvegarde du 1er de chaque mois est gardée 12 mois.
GED_SAUVEGARDE_RETENTION_JOURS=30
GED_SAUVEGARDE_RETENTION_MOIS=12

GED_JOURNAL=/var/log/ged/sauvegardes.log
